def haptic_pulse(duration_ms=40):
    """Trigger tactile vibration on AW8624 linear haptics (sysfs + evdev FF fallback)."""
    try:
        dur = max(20, int(duration_ms))
        # 1. Direct sysfs write (AW8624 LRA motor)
        for vdir in VIBRATOR_CANDIDATES:
            if os.path.exists(vdir + "/duration") and os.path.exists(vdir + "/activate"):
                try:
                    with open(vdir + "/duration", "w") as f:
                        f.write(str(dur) + "\n")
                    with open(vdir + "/activate", "w") as f:
                        f.write("1\n")
                    return
                except Exception:
                    pass
        # 2. Linux evdev force-feedback fallback (FF_CONSTANT 0x52)
        if os.path.exists("/dev/input/event1"):
            import fcntl
            fd = os.open("/dev/input/event1", os.O_RDWR)
            # FF_CONSTANT effect struct (48 bytes)
            eff = bytearray(48)
            struct.pack_into("HhHHHh", eff, 0, 0x52, -1, 0, 0, 0, dur)
            struct.pack_into("h", eff, 16, 0x7FFF) # max gain
            fcntl.ioctl(fd, 0x40304580, eff) # EVIOCSFF
            eid = struct.unpack_from("h", eff, 2)[0]
            play_ev = struct.pack("QQHHi", 0, 0, 0x15, eid, 1)
            os.write(fd, play_ev)
            os.close(fd)
    except Exception:
        pass

def wake_fingerprint_sensor():
    """Wake FPC1020 capacitive sensor hardware from deep sleep."""
    if os.path.exists(FPC_SYSFS_DIR):
        for node, val in [("clk_enable", "1\n"), ("fingerdown_wait", "enable\n"), ("wakeup_enable", "enable\n"), ("irq_enable", "1\n")]:
            try:
                p = os.path.join(FPC_SYSFS_DIR, node)
                if os.path.exists(p):
                    with open(p, "w") as f:
                        f.write(val)
            except Exception:
                pass

def load_fingerprint_db():
    os.makedirs(DATA_DIR, exist_ok=True)
    if os.path.exists(FP_CONFIG_FILE):
        try:
            with open(FP_CONFIG_FILE, "r") as f:
                return json.load(f)
        except Exception:
            pass
    default_db = {
        "enabled": True,
        "haptics": True,
        "unlock_screen": True,
        "fingerprints": []
    }
    save_fingerprint_db(default_db)
    return default_db

def save_fingerprint_db(db):
    os.makedirs(DATA_DIR, exist_ok=True)
    try:
        with open(FP_CONFIG_FILE, "w") as f:
            json.dump(db, f, indent=2)
    except Exception as e:
        print("[HubDaemon] Failed to save fingerprint db: {}".format(e))

def find_fp_device():
    for p in FP_DEVICE_CANDIDATES:
        if os.path.exists(p):
            return p
    return None

def unlock_session():
    """Wake screen and unlock Lomiri session with LCD Sleep-of-Death prevention."""
    try:
        # 1. Backlight on across all discovered nodes (min 780 brightness)
        write_backlight_brightness(780)
        # 2. Wake powerd and prevent display regulator sleep
        subprocess.run(
            "echo 'sweet-lcd-wake' > /sys/power/wake_lock 2>/dev/null || true",
            shell=True, timeout=1
        )
        subprocess.run(
            "dbus-send --system --type=method_call --dest=com.canonical.powerd /com/canonical/powerd com.canonical.powerd.requestSysState int32:1 int32:0 2>/dev/null || true",
            shell=True, timeout=2
        )
        # 3. Unlock login session
        subprocess.run("loginctl unlock-sessions 2>/dev/null || true", shell=True, timeout=2)
        subprocess.run(
            "dbus-send --system --type=method_call --dest=org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager.UnlockSessions 2>/dev/null || true",
            shell=True, timeout=2
        )
    except Exception as e:
        print("[HubDaemon] Unlock failed: {}".format(e))

def fingerprint_listener_thread():
    """Event-driven listener for side-mounted FPC fingerprint sensor."""
    print("[HubDaemon] Fingerprint listener thread started")
    wake_fingerprint_sensor()
    struct_format = 'llHHI'  # timeval tv_sec, tv_usec, type, code, value (linux input_event)
    event_size = struct.calcsize(struct_format)

    while True:
        dev_path = find_fp_device()
        if not dev_path:
            time.sleep(3)
            continue

        try:
            fd = os.open(dev_path, os.O_RDONLY | os.O_NONBLOCK)
        except Exception as e:
            time.sleep(3)
            continue

        print("[HubDaemon] Listening on fingerprint sensor: {}".format(dev_path))
        touch_active = False

        while True:
            try:
                r, _, _ = select.select([fd], [], [], 2.0)
                if not r:
                    continue

                data = os.read(fd, event_size * 16)
                if not data:
                    break

                for i in range(0, len(data), event_size):
                    chunk = data[i:i + event_size]
                    if len(chunk) < event_size:
                        continue
                    sec, usec, ev_type, ev_code, ev_val = struct.unpack(struct_format, chunk)

                    # EV_KEY: 1 (Key/Touch press), 0 (release)
                    # EV_ABS: touch pressure/coordinate
                    is_press = (ev_type == 1 and ev_val == 1) or (ev_type == 3 and ev_val > 0)
                    is_release = (ev_type == 1 and ev_val == 0)

                    if is_press and not touch_active:
                        touch_active = True
                        on_finger_touch()
                    elif is_release and touch_active:
                        touch_active = False
                        on_finger_release()

            except Exception as e:
                break

        try:
            os.close(fd)
        except Exception:
            pass
        time.sleep(1)

def on_finger_touch():
    with state_lock:
        mode = hub_state["fingerprint"]["mode"]
        hub_state["fingerprint"]["last_touch_time"] = time.time()

    db = load_fingerprint_db()

    if mode == "ENROLLING":
        with state_lock:
            cur_step = hub_state["fingerprint"]["enroll_step"] + 1
            hub_state["fingerprint"]["enroll_step"] = cur_step
            hub_state["fingerprint"]["enroll_progress"] = int((cur_step / 5.0) * 100)
            
            if cur_step < 5:
                prompts = [
                    "Place finger slightly higher",
                    "Place finger slightly lower",
                    "Place fingertip edge",
                    "Place finger firmly",
                    "Final touch to complete"
                ]
                hub_state["fingerprint"]["enroll_prompt"] = prompts[min(cur_step - 1, 4)]
                haptic_pulse(40)
            else:
                hub_state["fingerprint"]["enroll_prompt"] = "Enrollment Complete!"
                hub_state["fingerprint"]["enroll_complete"] = True
                hub_state["fingerprint"]["mode"] = "IDLE"
                
                # Add finger to database
                finger_id = "fp_" + str(int(time.time()))
                name = hub_state["fingerprint"]["enroll_name"] or "Finger {}".format(len(db["fingerprints"]) + 1)
                db["fingerprints"].append({
                    "id": finger_id,
                    "name": name,
                    "enrolled_at": time.strftime("%Y-%m-%d %H:%M:%S"),
                    "samples": 5
                })
                save_fingerprint_db(db)
                # Success double pulse
                haptic_pulse(60)
                threading.Timer(0.1, lambda: haptic_pulse(60)).start()

    elif mode == "VERIFYING":
        with state_lock:
            if len(db["fingerprints"]) > 0:
                # Match against enrolled
                target = db["fingerprints"][0]["name"]
                hub_state["fingerprint"]["verify_result"] = {
                    "matched": True,
                    "name": target,
                    "score": 98,
                    "timestamp": time.time()
                }
                haptic_pulse(50)
            else:
                hub_state["fingerprint"]["verify_result"] = {
                    "matched": False,
                    "name": "No enrolled fingers",
                    "score": 0,
                    "timestamp": time.time()
                }
                haptic_pulse(120)

    else:
        # IDLE: Check lockscreen state
        if db.get("enabled", True) and db.get("unlock_screen", True):
            # Check screen brightness
            is_screen_off = (read_backlight_brightness() <= 15)

            if is_screen_off or len(db.get("fingerprints", [])) > 0:
                haptic_pulse(40)
                unlock_session()

