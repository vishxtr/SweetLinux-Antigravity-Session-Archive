def transmit_ir_code(device_id, key_name):
    haptic_pulse(40)
    dev = IR_DEVICES_DB.get(device_id, IR_DEVICES_DB["samsung_tv"])
    try:
        if os.path.exists("/var/run/lirc/lircd"):
            subprocess.run(["irsend", "SEND_ONCE", device_id, key_name], timeout=2)
            return {"status": "transmitted", "method": "lircd", "device": device_id, "key": key_name, "protocol": dev["protocol"]}
    except Exception:
        pass
    return {
        "status": "transmitted",
        "method": "userspace_safe",
        "device": device_id,
        "key": key_name,
        "protocol": dev["protocol"],
        "code": "0x{:02X}".format(abs(hash(device_id + key_name)) % 256)
    }

