def is_lcd_panel():
    if os.path.exists(PANEL_TYPE_FILE):
        try:
            with open(PANEL_TYPE_FILE, "r") as f:
                content = f.read().lower().strip()
                if "amoled" in content:
                    return False
                if "lcd" in content:
                    return True
        except Exception:
            pass
    if os.path.exists("/sys/class/leds/lcd-backlight") or os.path.exists("/etc/default/sweet-lcd"):
        return True

    # Check DSI panel name for OEM Samsung AMOLED vs aftermarket LCD
    for pnode in [
        "/sys/devices/platform/soc/ae00000.qcom,mdss_mdp/drm/card0/card0-DSI-1/panel_info",
        "/sys/class/drm/card0-DSI-1/panel_info",
        "/sys/devices/virtual/graphics/fb0/msm_fb_panel_info"
    ]:
        if os.path.exists(pnode):
            try:
                with open(pnode, "r") as f:
                    pinfo = f.read().lower()
                    if any(x in pinfo for x in ["dsi_k6_38_0c_0a_fhd_dsc_video", "samsung", "ea8076"]):
                        return False
                    if any(x in pinfo for x in ["lcd", "tianma", "huaxing", "boe", "ft8719", "nt36"]):
                        return True
            except Exception:
                pass
    return False

def get_backlight_nodes():
    return [c for c in BACKLIGHT_CANDIDATES if os.path.exists(c) and os.path.exists(os.path.join(c, "brightness"))]

def read_backlight_brightness():
    for node in get_backlight_nodes():
        try:
            with open(os.path.join(node, "brightness"), "r") as f:
                val = int(f.read().strip())
                if val >= 0:
                    return val
        except Exception:
            pass
    return 700

def write_backlight_brightness(val):
    # Enforce minimum floor of 15 to prevent permanent pitch-black screen on LCD
    clamped = max(15, min(2047, int(val)))
    success = False
    for node in get_backlight_nodes():
        try:
            with open(os.path.join(node, "brightness"), "w") as f:
                f.write(str(clamped) + "\n")
            success = True
        except Exception:
            pass
    return success

