class HubApiHandler(BaseHTTPRequestHandler):
    def _send_json(self, data, code=200):
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()
        self.wfile.write(json.dumps(data).encode("utf-8"))

    def do_OPTIONS(self):
        self._send_json({"status": "ok"})

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path

        if path == "/api/status":
            self._send_json({"status": "online", "model": "Redmi Note 10 Pro (sweet)"})

        # --- FINGERPRINT API ---
        elif path == "/api/fingerprint/status":
            db = load_fingerprint_db()
            with state_lock:
                fp_info = dict(hub_state["fingerprint"])
            fp_info["config"] = {
                "enabled": db.get("enabled", True),
                "haptics": db.get("haptics", True),
                "unlock_screen": db.get("unlock_screen", True)
            }
            fp_info["fingerprints"] = db.get("fingerprints", [])
            fp_info["sensor_present"] = (find_fp_device() is not None)
            self._send_json(fp_info)

        elif path == "/api/fingerprint/enroll/poll":
            with state_lock:
                st = dict(hub_state["fingerprint"])
            self._send_json({
                "mode": st["mode"],
                "step": st["enroll_step"],
                "progress": st["enroll_progress"],
                "prompt": st["enroll_prompt"],
                "complete": st["enroll_complete"]
            })

        elif path == "/api/fingerprint/verify/poll":
            with state_lock:
                res = hub_state["fingerprint"]["verify_result"]
            self._send_json({"result": res})

        # --- DISPLAY API ---
        elif path == "/api/display/status":
            fps = 60 if is_lcd_panel() else 120
            if os.path.exists(FPS_STATE_FILE):
                try:
                    with open(FPS_STATE_FILE, "r") as f:
                        fps = int(f.read().strip())
                except Exception:
                    pass
            cur_bright = read_backlight_brightness()
            with state_lock:
                disp_info = dict(hub_state["display"])
            disp_info["fps"] = fps
            disp_info["brightness"] = cur_bright
            if is_lcd_panel():
                disp_info["panel_vendor"] = "Replacement In-Cell LCD FHD+ (60Hz Locked)"
                disp_info["refresh_rates"] = [60]
                disp_info["fps"] = 60
            else:
                disp_info["panel_vendor"] = "Samsung EA8076 Super AMOLED (120Hz/60Hz)"
                disp_info["refresh_rates"] = [60, 120]
            self._send_json(disp_info)

        # --- BATTERY API ---
        elif path == "/api/battery/status":
            batt = {
                "voltage_mv": 4200,
                "current_ma": 0,
                "wattage_w": 0.0,
                "percentage": 85,
                "status": "Discharging",
                "temp_c": 31.5,
                "is_fast_charge": False,
                "charge_speed": "Standard",
                "health_pct": 98,
                "capacity_mah": 5020,
                "profile": hub_state["battery"]["profile"]
            }
            try:
                if os.path.exists(BATTERY_DIR + "/capacity"):
                    with open(BATTERY_DIR + "/capacity", "r") as f:
                        batt["percentage"] = int(f.read().strip())
                if os.path.exists(BATTERY_DIR + "/status"):
                    with open(BATTERY_DIR + "/status", "r") as f:
                        batt["status"] = f.read().strip()
                if os.path.exists(BATTERY_DIR + "/voltage_now"):
                    with open(BATTERY_DIR + "/voltage_now", "r") as f:
                        raw_v = int(f.read().strip())
                        batt["voltage_mv"] = raw_v // 1000 if raw_v > 100000 else raw_v
                if os.path.exists(BATTERY_DIR + "/current_now"):
                    with open(BATTERY_DIR + "/current_now", "r") as f:
                        raw_i = abs(int(f.read().strip()))
                        batt["current_ma"] = raw_i // 1000 if raw_i > 100000 else raw_i
                if os.path.exists(BATTERY_DIR + "/temp"):
                    with open(BATTERY_DIR + "/temp", "r") as f:
                        batt["temp_c"] = round(int(f.read().strip()) / 10.0, 1)

