                except Exception:
                    pass
            self._send_json(data)

        elif path == "/api/camera/status":
            cur_lens = "main"
            idx = 0
            if os.path.exists(CAMERA_STATE_FILE):
                try:
                    with open(CAMERA_STATE_FILE, "r") as f:
                        idx = int(f.read().strip())
                except Exception:
                    pass
            lens_map = {
                0: {"name": "main", "label": "108MP Samsung ISOCELL HM2 Main", "res": "108MP / 12MP Binning"},
                1: {"name": "selfie", "label": "16MP Sony IMX471 Front Selfie", "res": "16MP (f/2.45)"},
                2: {"name": "wide", "label": "8MP Sony IMX355 Ultra-Wide (118°)", "res": "8MP (f/2.2)"},
                3: {"name": "macro", "label": "5MP OmniVision OV5675 Telemacro", "res": "5MP (2-10cm AF)"}
            }
            self._send_json({
                "active_index": idx,
                "active_lens": lens_map.get(idx, lens_map[0]),
                "all_lenses": [lens_map[0], lens_map[1], lens_map[2], lens_map[3]]
            })
        elif path == "/api/ir/devices":
            self._send_json({"status": "ok", "devices": IR_DEVICES_DB})

        elif path == "/api/sensors/status":
            self._send_json(get_sensor_readings())

        else:
            self._send_json({"error": "Endpoint not found"}, code=404)

    def do_POST(self):
        parsed = urlparse(self.path)
        path = parsed.path
        query = parse_qs(parsed.query)

        # --- FINGERPRINT ACTIONS ---
        if path == "/api/fingerprint/enroll/start":
            name = query.get("name", ["Finger"])[0]
            with state_lock:
                hub_state["fingerprint"]["mode"] = "ENROLLING"
                hub_state["fingerprint"]["enroll_name"] = name
                hub_state["fingerprint"]["enroll_step"] = 0
                hub_state["fingerprint"]["enroll_progress"] = 0
                hub_state["fingerprint"]["enroll_prompt"] = "Place finger on the side sensor"
                hub_state["fingerprint"]["enroll_complete"] = False
            haptic_pulse(40)
            self._send_json({"status": "enrollment_started", "name": name})

        elif path == "/api/fingerprint/enroll/cancel":
            with state_lock:
                hub_state["fingerprint"]["mode"] = "IDLE"
                hub_state["fingerprint"]["enroll_step"] = 0
                hub_state["fingerprint"]["enroll_progress"] = 0
                hub_state["fingerprint"]["enroll_complete"] = False
            self._send_json({"status": "enrollment_cancelled"})

        elif path == "/api/fingerprint/verify/start":
            with state_lock:
                hub_state["fingerprint"]["mode"] = "VERIFYING"
                hub_state["fingerprint"]["verify_result"] = None
            self._send_json({"status": "verifying_ready"})

        elif path == "/api/fingerprint/verify/stop":
            with state_lock:
                hub_state["fingerprint"]["mode"] = "IDLE"
            self._send_json({"status": "verifying_stopped"})

        elif path == "/api/fingerprint/delete":
            fp_id = query.get("id", [""])[0]
            db = load_fingerprint_db()
            db["fingerprints"] = [fp for fp in db.get("fingerprints", []) if fp.get("id") != fp_id]
            save_fingerprint_db(db)
            self._send_json({"status": "deleted", "id": fp_id})

        elif path == "/api/fingerprint/toggle":
            key = query.get("key", ["enabled"])[0]
            val = query.get("val", ["true"])[0].lower() == "true"
            db = load_fingerprint_db()
            db[key] = val
            save_fingerprint_db(db)
            self._send_json({"status": "updated", key: val})

        # --- DISPLAY ACTIONS ---
        elif path == "/api/display/set":
            fps_str = query.get("fps", ["120"])[0]
            try:
                subprocess.run(["/usr/local/bin/sweet-fps", fps_str], timeout=5)
            except Exception:
                pass
            self._send_json({"status": "fps_set", "fps": int(fps_str)})

        elif path == "/api/display/brightness":
            val_str = query.get("value", ["700"])[0]
            try:
                write_backlight_brightness(val_str)
            except Exception:
                pass
            self._send_json({"status": "brightness_set", "value": int(val_str)})

        # --- BATTERY ACTIONS ---
        elif path == "/api/battery/profile":
            pname = query.get("name", ["balanced"])[0]
            with state_lock:
                hub_state["battery"]["profile"] = pname
            if pname == "saver":
                # Hot-unplug Kryo Gold cores 6 & 7
                subprocess.run("echo 0 > /sys/devices/system/cpu/cpu6/online 2>/dev/null || true", shell=True)
                subprocess.run("echo 0 > /sys/devices/system/cpu/cpu7/online 2>/dev/null || true", shell=True)
            elif pname == "performance":
                subprocess.run("echo 1 > /sys/devices/system/cpu/cpu6/online 2>/dev/null || true", shell=True)
                subprocess.run("echo 1 > /sys/devices/system/cpu/cpu7/online 2>/dev/null || true", shell=True)
            self._send_json({"status": "profile_set", "profile": pname})

        # --- VOLTE ACTIONS ---
        elif path == "/api/volte/repair_ims":
            threading.Thread(target=lambda: subprocess.run("/usr/local/bin/sweet-volte &", shell=True)).start()
            self._send_json({"status": "volte_repair_triggered"})

        # --- CAMERA ACTIONS ---
        # --- INTEGRITY ACTIONS ---
        elif path == "/api/integrity/convert_module":
            mod_path = query.get("path", [""])[0]
            if os.path.exists(mod_path):
                res = subprocess.getoutput("/usr/local/bin/sweet-magisk-converter {}".format(mod_path))
                self._send_json({"status": "converted", "log": res[-150:] if len(res) > 150 else res})
            else:
                self._send_json({"status": "error", "log": "File not found: " + mod_path})

        elif path == "/api/integrity/update_fingerprint":
            subprocess.run(["/usr/local/bin/sweet-play-integrity", "setup"])
            self._send_json({"status": "fingerprint_updated"})

        elif path == "/api/camera/lens":
            lens = query.get("lens", ["main"])[0]
            subprocess.run(["/usr/local/bin/sweet-camera-lens", lens])
            self._send_json({"status": "lens_set", "lens": lens})
        elif path == "/api/ir/send":
            dev = query.get("device", ["samsung_tv"])[0]
            key = query.get("key", ["power"])[0]
            res = transmit_ir_code(dev, key)
            self._send_json(res)

        elif path == "/api/sensors/orientation":
            mode = query.get("mode", ["auto"])[0]
            if mode == "auto":
                subprocess.run("gsettings set com.canonical.indicator.rotation.settings lock-orientation false 2>/dev/null || true", shell=True)
                with state_lock:
                    hub_state["sensors"]["auto_rotate"] = True
            elif mode == "portrait":
                subprocess.run("gsettings set com.canonical.indicator.rotation.settings lock-orientation true 2>/dev/null || true", shell=True)
                with state_lock:
                    hub_state["sensors"]["auto_rotate"] = False
                    hub_state["sensors"]["orientation"] = "portrait"
            elif mode == "landscape":
                subprocess.run("gsettings set com.canonical.indicator.rotation.settings lock-orientation true 2>/dev/null || true", shell=True)
                with state_lock:
                    hub_state["sensors"]["auto_rotate"] = False
                    hub_state["sensors"]["orientation"] = "landscape"
            self._send_json({"status": "orientation_updated", "mode": mode})

        else:
            self._send_json({"error": "Action not found"}, code=404)

    def log_message(self, format, *args):
        # Silence HTTP access logs to keep systemd journal clean
        return

def run_server():
    server = HTTPServer(("127.0.0.1", 8088), HubApiHandler)
    print("[HubDaemon] REST API Server listening on http://127.0.0.1:8088")
    server.serve_forever()

if __name__ == "__main__":
    print("[HubDaemon] Starting SweetLinux Hardware & Biometrics Daemon...")
    load_fingerprint_db()
    t_fp = threading.Thread(target=fingerprint_listener_thread, daemon=True)
    t_fp.start()
    run_server()
